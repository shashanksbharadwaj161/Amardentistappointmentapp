{
  "expo": {
    "name": "Amar Dentist",
    "slug": "amar-dentist",
    "scheme": "amardentist",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amardentist.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.amardentist.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Amar Dentist to use your location while finding nearby verified clinics."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Amar Dentist to scan one-time clinic check-in QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F8F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite"
    ]
  }
}
